# init4sec — configuração
# Copie para .env (ou exporte as variáveis) — também é possível configurar pela aba "Config" da UI.
# Variáveis de ambiente têm precedência sobre o que for salvo pela UI.

# Token Bearer da X API v2 (developer.x.com). Sem ele o sistema roda em modo DEMO.
X_BEARER_TOKEN=

# Tamanho máximo da query da X API (512 nos planos Free/Basic, 1024 no Pro/Enterprise)
X_QUERY_MAX_LEN=512

# Chave da API da Anthropic (Claude) para gerar o briefing de inteligência.
# Sem ela, o briefing é gerado pelo motor heurístico local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Servidor
HOST=127.0.0.1
PORT=4444

# Se definido, a UI/API exigem esta chave de acesso (header x-init4sec-key)
INIT4SEC_ACCESS_KEY=
